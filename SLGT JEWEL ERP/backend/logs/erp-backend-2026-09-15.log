{"ts":"2026-09-15T09:37:20.990Z","level":"debug","scope":"sqlite","message":"query","meta":{"sql":"Executing (default): SELECT `customer_id` AS `customer_id`, COUNT(`id`) AS `invoice_count`, COALESCE(SUM(`grand_total`), 0) AS `grand_total` FROM `invoices` AS `Invoice` WHERE (((`Invoice`.`business_date` >= '2026-08-16' AND `Invoice`.`business_date` <= '2026-09-15') OR (`Invoice`.`business_date` IS NULL AND (`Invoice`.`created_at` >= '2026-08-16 00:00:00.000 +00:00' AND `Invoice`.`created_at` <= '2026-09-15 18:29:59.999 +00:00'))) AND `Invoice`.`status` NOT IN ('cancelled', 'canceled', 'void', 'voided', 'returned') AND (`Invoice`.`is_hidden` = 0 OR `Invoice`.`is_hidden` IS NULL)) AND `Invoice`.`customer_id` IS NOT NULL GROUP BY `customer_id` ORDER BY SUM(`grand_total`) DESC LIMIT 20;"}}
{"ts":"2026-09-15T09:37:20.996Z","level":"debug","scope":"sqlite","message":"query","meta":{"sql":"Executing (default): SELECT `customer_id` AS `customer_id`, COUNT(`id`) AS `invoice_count`, COALESCE(SUM(`grand_total`), 0) AS `total_spent`, MIN(`created_at`) AS `first_purchase`, MAX(`created_at`) AS `last_purchase` FROM `invoices` AS `Invoice` WHERE ((`Invoice`.`status` NOT IN ('cancelled', 'canceled', 'void', 'voided', 'returned') AND `Invoice`.`customer_id` IS NOT NULL) AND (`Invoice`.`is_hidden` = 0 OR `Invoice`.`is_hidden` IS NULL)) GROUP BY `customer_id` ORDER BY COUNT(`id`) DESC;"}}
{"ts":"2026-09-15T09:37:21.001Z","level":"debug","scope":"sqlite","message":"query","meta":{"sql":"Executing (default): SELECT `customer_id` AS `customer_id`, COUNT(`id`) AS `invoice_count`, COALESCE(SUM(`grand_total`), 0) AS `total_spent`, MIN(`created_at`) AS `first_purchase`, MAX(`created_at`) AS `last_purchase` FROM `invoices` AS `Invoice` WHERE ((`Invoice`.`status` NOT IN ('cancelled', 'canceled', 'void', 'voided', 'returned') AND `Invoice`.`customer_id` IS NOT NULL) AND (`Invoice`.`is_hidden` = 0 OR `Invoice`.`is_hidden` IS NULL)) GROUP BY `customer_id` ORDER BY COUNT(`id`) DESC;"}}
