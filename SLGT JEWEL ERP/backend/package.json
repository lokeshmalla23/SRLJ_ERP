{
  "name": "aurum-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "start:branch": "node src/scripts/startBranch.js",
    "branch:bootstrap": "node src/scripts/bootstrapBranchPostgres.js",
    "branch:stop-db": "node src/scripts/bootstrapBranchPostgres.js --stop",
    "branch:setup-system-pg": "node src/scripts/setupLocalPostgres.js --create",
    "smoke:branch": "node src/scripts/smokeBranch.js",
    "certs:generate": "node src/scripts/generateShopCerts.js",
    "migrate:permissions": "node src/scripts/backfillPermissions.js",
    "migrate": "node src/migrate.js",
    "migrate:down": "node src/migrate.js down",
    "test:sequences": "node tests/invoiceSequence.test.js",
    "test:quote-seq": "node tests/quotationSequence.test.js",
    "test:inventory": "node tests/inventoryService.test.js",
    "test:inventory-backup": "node tests/inventoryBackup.test.js",
    "test:customer-backup": "node tests/customerBackup.test.js",
    "test:billing": "node tests/billingService.test.js",
    "test:financial-mode": "node tests/financialMode.test.js && node tests/preAccountsPos.test.js && node tests/cancelledInvoiceStatement.test.js",
    "test:lan-p0": "node tests/lanP0Hardening.test.js",
    "test:phase1": "node tests/lanPhase1.test.js",
    "test:phase2": "node tests/phase2Plus.test.js",
    "test:purchase-e2e": "node tests/purchaseTagPosReturn.test.js",
    "test:remediation": "node tests/remediationP0P1.test.js",
    "test:oldgold": "node tests/oldGoldNonCash.test.js",
    "test:accrual": "node tests/accrualPhase1.test.js",
    "test:booking": "node tests/quotationBooking.test.js",
    "test:sync": "node tests/syncService.test.js",
    "test:acceptance": "node tests/acceptanceSimulation.test.js",
    "test:ratemap": "node tests/billingCalcRateMap.test.js",
    "test:gaps": "node tests/coverageGaps.test.js",
    "test:smoke-path": "node tests/shopSmokePath.test.js",
    "test:coverage": "node tests/billingCalcRateMap.test.js && node tests/coverageGaps.test.js && node tests/shopSmokePath.test.js && node tests/quotationBooking.test.js",
    "audit:barcodes": "node src/scripts/auditDuplicateBarcodes.js",
    "audit:inventory": "node src/scripts/auditInventory.js",
    "audit:billing": "node src/scripts/auditBilling.js",
    "seed:demo": "node src/scripts/seedShopDemoData.js",
    "seed:demo:force": "node src/scripts/seedShopDemoData.js --force",
    "normalize:permissions": "node src/scripts/normalizePermissions.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "umzug": "^3.8.3",
    "uuid": "^14.0.1",
    "ws": "^8.21.1"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "argon2@0.45.1": true
  }
}
